{
	"family": "bigbro",
	"networkMode": "awsvpc",
	"containerDefinitions": [
		{
			"name": "bigbro-stage-container",
			"image": "PLACEHOLDER_IMAGE",
			"essential": true,
			"memory": 512,
			"cpu": 256,
			"portMappings": [
				{
					"containerPort": 8000,
					"protocol": "tcp"
				}
			],
			"environmentFiles": [
				{
					"value": "arn:aws:s3:::bigbro-company/.env.stage",
					"type": "s3"
				}
			]
		}
	],
	"requiresCompatibilities": [
		"FARGATE"
	],
	"cpu": "256",
	"memory": "512",
	"executionRoleArn": "arn:aws:iam::302263070053:role/ecs"
}
